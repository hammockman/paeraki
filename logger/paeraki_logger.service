[Unit]
Description=Paeraki Vessel Telemetry Logger Service
After=network.target

[Service]
WorkingDirectory=/home/jh/paeraki
ExecStart=/usr/bin/uv run --python /home/jh/paeraki/.venv /home/jh/paeraki/logger/logger.py --db-path /home/jh/paeraki/data/paeraki.db
Restart=always
RestartSec=5
User=jh

[Install]
WantedBy=multi-user.target

